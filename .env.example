# Salin menjadi .env lalu sesuaikan
NODE_ENV=development
PORT=4000

# WAJIB diganti di produksi (min. 24 karakter acak)
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-24-karakter

# Akun admin awal (dibuat saat DB masih kosong)
ADMIN_EMAIL=admin@kitabikin.id
ADMIN_PASSWORD=Admin#12345

# Isi data contoh (matikan di produksi)
SEED_DEMO=true

DB_PATH=./data/kitabikin.db
CORS_ORIGIN=http://localhost:5173
SITE_URL=https://kitabikin.id
